{
  "schema_version": "heprobench_preprocessing_v1",
  "dataset": {
    "root_dir": "../../data/dataset",
    "slide_manifest": "manifests/slides.csv",
    "columns": {
      "sample_id": "sample_id",
      "slide_id": "slide_id",
      "fov_id": "fov_id",
      "he_path": "he_path",
      "target_path": "target_path",
      "origin_y_px": "origin_y_px",
      "origin_x_px": "origin_x_px"
    },
    "access": {
      "data_in_repository": false,
      "manifest_policy": "deidentified_ids_only"
    }
  },
  "split": {
    "group_column": "group_id",
    "split_column": "split",
    "reuse_existing": true,
    "ratios": {
      "train": 0.7,
      "valid": 0.1,
      "test": 0.2
    },
    "seed": 42
  },
  "registration": {
    "method": "valis",
    "reference_modality": "multiplex",
    "moving_modality": "H&E",
    "align_to_reference": true,
    "non_rigid": true,
    "crop": "reference",
    "level": 0,
    "quality": 85,
    "skip_existing": true
  },
  "registration_qc": {
    "enabled": true,
    "he_reference": "inverse_red",
    "thumbnail_max_side": 1024,
    "require_manual_acceptance": true
  },
  "tiling": {
    "patch_size": 256,
    "stride": 256,
    "target_channel_axis": "auto"
  },
  "normalization": {
    "fit_split": "train",
    "percentile": 99.9,
    "samples_per_patch": 10000,
    "transform": "legacy_log1p",
    "divide_by_log2": false,
    "output_dtype": "preserve_input"
  },
  "patch_qc": {
    "enabled": true,
    "he_reference": "inverse_red",
    "he_inverse_channel": 0,
    "nuclear_std_min": 11.0,
    "robust_nmi_min": 0.03,
    "gaussian_sigma": 1.5,
    "robust_nmi_bins": 16,
    "diagnostic_nmi_bins": 64,
    "min_foreground_pixels": 100
  },
  "segmentation": {
    "model": "Mesmer",
    "boundary_reduction": "maximum_of_independently_minmax_normalized_channels",
    "maxima_algorithm": "peak_local_max"
  },
  "cell_extraction": {
    "expression_aggregation": "mean",
    "evaluation_patch_assignment": "centroid",
    "background_id": 0
  },
  "gating": {
    "model": "GaussianMixture",
    "n_components": 2,
    "positive_only_fit": true,
    "posterior_threshold": 0.5,
    "max_cells_per_marker": 300000,
    "min_cells_to_fit": 2000,
    "seed": 42,
    "separation_min": 1.5,
    "positive_rate_min": 0.01,
    "positive_rate_max": 0.99
  }
}
