  "native": {
    "train": {"args": {"input_nc": 4, "output_nc": 4, "display_id": -1}},
    "infer": {"config": {"input_nc": 4, "output_nc": 4, "checkpoints_dir": "../../outputs/demo/cut/checkpoints", "name": "cut-demo"}}
  }
