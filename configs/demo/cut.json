{
  "extends": "../experiments/cut.json",
  "data": {
    "root_dir": "../../demo_data",
    "train_csv": "../../demo_data/splits/train.csv",
    "val_csv": "../../demo_data/splits/valid.csv",
    "test_csv": "../../demo_data/splits/test.csv",
    "csv_path": "../../demo_data/splits/{split}.csv",
    "channel_names_file": "../../demo_data/channel_names.json"
  },
  "train": {"batch_size": 1, "num_workers": 0, "total_iterations": 1, "save_latest_freq": 1000, "save_per_iteration": 1000},
